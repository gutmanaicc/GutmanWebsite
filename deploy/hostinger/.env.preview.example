# Copy privately to .env.preview for local Compose or supply its equivalent
# through the Hostinger Docker create API environment string; never print it.
# Existing VPS inspection: host-mode Traefik, websecure, letsencrypt.
GUTMAN_PREVIEW_HOST=academy-preview.srv1942778.hstgr.cloud
TRAEFIK_HTTPS_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
# Local checkout only. Remote build must use authorized HTTPS Git URL#full SHA.
GUTMAN_BUILD_CONTEXT=../..
GUTMAN_SOURCE_REVISION=uncommitted-local
GUTMAN_IMAGE_TAG=node24
GUTMAN_MEDIA_IMAGE_TAG=
ACADEMY_PUBLIC_ORIGIN=https://academy-preview.srv1942778.hstgr.cloud
ACADEMY_ALLOWED_ORIGINS=https://academy-preview.srv1942778.hstgr.cloud
ACADEMY_ADMIN_TOKEN=
ACADEMY_ORDER_SECRET=
ACADEMY_PAYMENT_MODE=disabled
ACADEMY_BOOKING_TERMS_APPROVED=0
MORNING_API_ID=
MORNING_API_SECRET=
MORNING_WEBHOOK_SECRET=
MORNING_ENVIRONMENT=production
MORNING_BUSINESS_TAX_ID=
MORNING_CHECKOUT_ORIGINS=
MORNING_MERCHANT_VERIFIED=0
RESEND_API_KEY=
ACADEMY_EMAIL_FROM=
ACADEMY_EMAIL_DELIVERY_ENABLED=0
ACADEMY_EMAIL_SENDER_VERIFIED=0
ACADEMY_EMAIL_APPROVED_KINDS=
# Preserve existing legacy lead integrations only with authorized server credentials.
FIREBERRY_TOKEN=
FIREBERRY_OBJECT_TYPE=1
FIREBERRY_FIELD_MAP=
LEAD_DIAG_KEY=
ALLOW_UNCONFIGURED_LEADS=0
LEAD_TIMEOUT_MS=10000
SENTRY_DSN=
SENTRY_ENVIRONMENT=hostinger-preview
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Optional direct Drive -> own VPS media overlay ONLY. Never upload these files
# to public Git, Composio artifacts or another storage provider.
# Obtain a fresh original Drive-connector signed URL immediately before seed.
ACADEMY_TESTIMONIAL_SOURCE=
ACADEMY_TESTIMONIAL_SOURCE_SHA256=e90cc52c3d394a65e5fcbac9048adf1fa2a12c17aa3e15dee7227e1d30b6b4bf
