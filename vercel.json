{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/payment-thanks", "destination": "/payment-thanks.html" },
    { "source": "/((?!api/|assets/).*)", "destination": "/index.html" }
  ]
}
