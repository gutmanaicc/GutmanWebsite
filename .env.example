# ─────────────────────────────────────────────────────────────
#  משתני סביבה של האתר
#
#  מה שמוגדר כאן הוא דוגמה בלבד. הערכים האמיתיים נכנסים ב-Vercel:
#  Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────

# ── צד שרת (סודי, לא מגיע לדפדפן) ────────────────────────────

# מפתח ה-API של פיירברי. בלעדיו /api/lead מחזירה 503 וכל שליחת טופס
# נכשלת בכוונה: עדיף להציג לגולש כישלון מאשר לומר לו "קיבלנו" בזמן
# שהליד לא הגיע לאף אחד. חובה לפני עלייה לאוויר.
# איפה מוצאים: פיירברי → הגדרות → API → Token ID
FIREBERRY_TOKEN=

# סוג הרשומה שנפתחת בפיירברי. ברירת מחדל "1" (לקוחות/accounts).
# להריץ scripts/fireberry-check.mjs כדי לראות את המספרים בחשבון שלכם.
FIREBERRY_OBJECT_TYPE=1

# פתח מילוט לסביבות בלי CRM, למשל תצוגה מקדימה: מחזיר 200 לשליחת
# טופס גם בלי FIREBERRY_TOKEN, כדי שאפשר יהיה לעבור את הטופס מקצה
# לקצה. אסור בייצור. הליד עדיין נרשם ליומן בשורת LEAD_CAPTURE.
# ALLOW_UNCONFIGURED_LEADS=1


# ── צד לקוח (נחשף בקוד המקור של האתר) ────────────────────────

# יעד חלופי לשליחת לידים. ברירת המחדל היא /api/lead, שהיא
# פונקציית השרת של האתר עצמו. להשאיר ריק אלא אם עוברים ל-Make
# או ל-Zapier במקום פיירברי.
VITE_LEAD_ENDPOINT=
