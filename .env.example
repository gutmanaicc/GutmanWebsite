# ─────────────────────────────────────────────────────────────
#  משתני סביבה של האתר
#
#  מה שמוגדר כאן הוא דוגמה בלבד. הערכים האמיתיים נכנסים ב-Vercel:
#  Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────

# ── צד שרת (סודי, לא מגיע לדפדפן) ────────────────────────────

# מפתח ה-API של פיירברי. בלעדיו הטפסים באתר ימשיכו לעבוד, אבל
# הלידים לא ייפתחו כלקוחות ב-CRM. חובה לפני עלייה לאוויר.
# איפה מוצאים: פיירברי → הגדרות → API → Token ID
FIREBERRY_TOKEN=

# סוג הרשומה שנפתחת בפיירברי. ברירת מחדל "1" (לקוחות/accounts).
# להריץ scripts/fireberry-check.mjs כדי לראות את המספרים בחשבון שלכם.
FIREBERRY_OBJECT_TYPE=1


# ── צד לקוח (נחשף בקוד המקור של האתר) ────────────────────────

# יעד חלופי לשליחת לידים. ברירת המחדל היא /api/lead, שהיא
# פונקציית השרת של האתר עצמו. להשאיר ריק אלא אם עוברים ל-Make
# או ל-Zapier במקום פיירברי.
VITE_LEAD_ENDPOINT=
