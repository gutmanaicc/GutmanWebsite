# ─────────────────────────────────────────────────────────────
#  משתני סביבה של האתר
#
#  מה שמוגדר כאן הוא דוגמה בלבד. הערכים האמיתיים נכנסים ב-Vercel:
#  Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────

# ── צד שרת (סודי, לא מגיע לדפדפן) ────────────────────────────

# מפתח ה-API של פיירברי. בלעדיו /api/lead מחזירה 503 וכל שליחת טופס
# נכשלת בכוונה: עדיף להציג לגולש כישלון מאשר לומר לו "קיבלנו" בזמן
# שהליד לא הגיע לאף אחד. חובה לפני עלייה לאוויר.
# איפה מוצאים: פיירברי → הגדרות → API → Token ID
FIREBERRY_TOKEN=

# סוג הרשומה שנפתחת בפיירברי. ברירת מחדל "1" (לקוחות/accounts).
# להריץ scripts/fireberry-check.mjs כדי לראות את המספרים בחשבון שלכם.
FIREBERRY_OBJECT_TYPE=1

# פתח מילוט לסביבות בלי CRM, למשל תצוגה מקדימה: מחזיר 200 לשליחת
# טופס גם בלי FIREBERRY_TOKEN, כדי שאפשר יהיה לעבור את הטופס מקצה
# לקצה. אסור בייצור. הליד עדיין נרשם ליומן בשורת LEAD_CAPTURE.
# ALLOW_UNCONFIGURED_LEADS=1


# ── צד לקוח (נחשף בקוד המקור של האתר) ────────────────────────

# יעד חלופי לשליחת לידים. ברירת המחדל היא /api/lead, שהיא
# פונקציית השרת של האתר עצמו. להשאיר ריק אלא אם עוברים ל-Make
# או ל-Zapier במקום פיירברי.
VITE_LEAD_ENDPOINT=


# ── ניטור והתראות (צד שרת, סודי) ─────────────────────────────

# ה-DSN של פרויקט Sentry. בלעדיו הדיווח ל-Sentry פשוט מדולג והכשל
# עדיין נרשם ליומן. איפה מוצאים: Sentry → Settings → Projects →
# <הפרויקט> → Client Keys (DSN).
# צורה: https://<publicKey>@<host>/<projectId>
SENTRY_DSN=

# שם הסביבה שיופיע ב-Sentry. בלי זה נלקח VERCEL_ENV אוטומטית,
# ובדרך כלל אין סיבה להגדיר את זה ידנית.
# SENTRY_ENVIRONMENT=production

# מפתח Resend לשליחת מייל ההתראה. Sentry מקבצת שגיאות ל-issue
# ומתריעה על issue חדש בלבד, ולכן נפילה ארוכה של פיירברי הייתה
# מייצרת מייל אחד על עשרים לידים שנפלו. המייל הזה יוצא על כל ליד
# בנפרד, כי לכל ליד צריך לחזור בנפרד.
RESEND_API_KEY=

# נמעני ההתראות. אפשר כמה, מופרדים בפסיק.
ALERT_EMAIL_TO=

# כתובת השולח. חייבת להיות על דומיין מאומת ב-Resend, אחרת השליחה
# נדחית. לבדיקה ראשונה אפשר onboarding@resend.dev, שמותר לשלוח ממנו
# רק לכתובת שאיתה נפתח החשבון.
ALERT_EMAIL_FROM=

# תקרת זמן לקריאה לפיירברי, במילישניות. ברירת מחדל 10000. בלי תקרה
# קריאה תקועה נבלעת ב-timeout של Vercel, והליד נעלם בלי שום עקבות.
# LEAD_TIMEOUT_MS=10000
